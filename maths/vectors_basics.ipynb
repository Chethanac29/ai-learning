   "cell_type": "code",
   "source": [
    "x = torch.tensor([1.,2.,3.])\n",
    "w = torch.tensor([1.,2.,3.])\n",
    "\n",
    "element_wise = x * w\n",
    "dot = torch.dot(x,w)\n",
    "\n",
    "print(\"Element wise: \",element_wise)\n",
    "print(\"Element wise shape: \" , element_wise.shape)\n",
    "print(\"Dot: \",dot)\n",
    "print(\"Dot Shape: \",dot.shape)"
